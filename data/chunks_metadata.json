[{"text": "The capital of India is New Delhi. It serves as the seat of executive, legislative, and judicial branches.", "chunk_id": "3823d79537a9", "strategy": "semantic_sentence", "language": "hin_Deva", "source_passage_index": 0, "query_type": "factual", "is_selected": true, "overlap_with_prev": false, "char_count": 106, "token_estimate": 35, "vector_id": 0}, {"text": "भारत की राजधानी नई दिल्ली है। यह भारत सरकार की तीनों शाखाओं का केंद्र है।", "chunk_id": "4f6ef8f66658", "strategy": "semantic_sentence", "language": "hin_Deva", "source_passage_index": 1, "query_type": "factual", "is_selected": true, "overlap_with_prev": false, "char_count": 73, "token_estimate": 24, "vector_id": 1}, {"text": "இந்தியாவின் தலைநகரம் புது தில்லி ஆகும். இது அரசின் தலைமை அமைப்பாக செயல்படுகிறது.", "chunk_id": "ad26b25e84eb", "strategy": "semantic_sentence", "language": "tam_Taml", "source_passage_index": 2, "query_type": "factual", "is_selected": true, "overlap_with_prev": false, "char_count": 80, "token_estimate": 26, "vector_id": 2}, {"text": "భారతదేశ రాజధాని న్యూఢిల్లీ. ఇది కేంద్ర ప్రభుత్వ కార్యస్థావరం.", "chunk_id": "00aa3e97aa25", "strategy": "semantic_sentence", "language": "tel_Telu", "source_passage_index": 3, "query_type": "factual", "is_selected": true, "overlap_with_prev": false, "char_count": 61, "token_estimate": 20, "vector_id": 3}, {"text": "ভারতের রাজধানী নয়াদিল্লি। এটি ভারত সরকারের প্রশাসনিক কেন্দ্র।", "chunk_id": "fe4aeb11552b", "strategy": "semantic_sentence", "language": "ben_Beng", "source_passage_index": 4, "query_type": "factual", "is_selected": true, "overlap_with_prev": false, "char_count": 62, "token_estimate": 20, "vector_id": 4}, {"text": "India is comprised of 28 states and 8 union territories, forming a federal parliamentary republic.", "chunk_id": "b84e9a14cd01", "strategy": "semantic_sentence", "language": "eng_Latn", "source_passage_index": 5, "query_type": "factual", "is_selected": true, "overlap_with_prev": false, "char_count": 98, "token_estimate": 32, "vector_id": 5}, {"text": "भारत में 28 राज्य और 8 केंद्र शासित प्रदेश हैं।", "chunk_id": "b15d5714e865", "strategy": "semantic_sentence", "language": "hin_Deva", "source_passage_index": 6, "query_type": "factual", "is_selected": true, "overlap_with_prev": false, "char_count": 47, "token_estimate": 15, "vector_id": 6}, {"text": "இந்தியாவில் 28 மாநிலங்களும் 8 কেন্দ্রশাসিত பிரதேசங்களும் உள்ளன.", "chunk_id": "b2efca8cd79a", "strategy": "semantic_sentence", "language": "tam_Taml", "source_passage_index": 7, "query_type": "factual", "is_selected": true, "overlap_with_prev": false, "char_count": 63, "token_estimate": 21, "vector_id": 7}, {"text": "భారతదేశంలో 28 రాష్ట్రాలు మరియు 8 కేంద్రపాలిత ప్రాంతాలు ఉన్నాయి.", "chunk_id": "21d8cb76dfbf", "strategy": "semantic_sentence", "language": "tel_Telu", "source_passage_index": 8, "query_type": "factual", "is_selected": true, "overlap_with_prev": false, "char_count": 63, "token_estimate": 21, "vector_id": 8}, {"text": "ভারতে ২৮টি রাজ্য এবং ৮টি কেন্দ্রশাসিত অঞ্চল রয়েছে।", "chunk_id": "1bf543f24036", "strategy": "semantic_sentence", "language": "ben_Beng", "source_passage_index": 9, "query_type": "factual", "is_selected": true, "overlap_with_prev": false, "char_count": 51, "token_estimate": 17, "vector_id": 9}, {"text": "The Ganges is the longest river flowing through India, originating from the Gangotri Glacier in the Himalayas.", "chunk_id": "0936f837ee83", "strategy": "semantic_sentence", "language": "eng_Latn", "source_passage_index": 10, "query_type": "factual", "is_selected": true, "overlap_with_prev": false, "char_count": 110, "token_estimate": 36, "vector_id": 10}, {"text": "गंगा नदी भारत की सबसे लंबी और पवित्र नदी है जो हिमालय के गंगोत्री हिमनद से निकलती है।", "chunk_id": "6e37e77e15fd", "strategy": "semantic_sentence", "language": "hin_Deva", "source_passage_index": 11, "query_type": "factual", "is_selected": true, "overlap_with_prev": false, "char_count": 85, "token_estimate": 28, "vector_id": 11}, {"text": "கங்கை நதி இந்தியாவின் மிக நீளமான நதியாகும். இது இமயமலையில் உருவாகிறது.", "chunk_id": "f68b25e403d9", "strategy": "semantic_sentence", "language": "tam_Taml", "source_passage_index": 12, "query_type": "factual", "is_selected": true, "overlap_with_prev": false, "char_count": 70, "token_estimate": 23, "vector_id": 12}, {"text": "గంగా నది భారతదేశంలో పొడవైన నది. ఇది హిమాలయాలలో జన్మిస్తుంది.", "chunk_id": "33dfbf3128cd", "strategy": "semantic_sentence", "language": "tel_Telu", "source_passage_index": 13, "query_type": "factual", "is_selected": true, "overlap_with_prev": false, "char_count": 60, "token_estimate": 20, "vector_id": 13}, {"text": "গঙ্গা নদী ভারতের দীর্ঘতম নদী যা হিমালয়ের গঙ্গোত্রী হিমবাহ থেকে উৎপন্ন হয়েছে।", "chunk_id": "8f0c0df91683", "strategy": "semantic_sentence", "language": "ben_Beng", "source_passage_index": 14, "query_type": "factual", "is_selected": true, "overlap_with_prev": false, "char_count": 78, "token_estimate": 26, "vector_id": 14}, {"text": "The Constitution of India came into effect on 26th January 1950, establishing India as a sovereign republic.", "chunk_id": "cb32c9956869", "strategy": "semantic_sentence", "language": "eng_Latn", "source_passage_index": 15, "query_type": "factual", "is_selected": true, "overlap_with_prev": false, "char_count": 108, "token_estimate": 36, "vector_id": 15}, {"text": "भारतीय संविधान 26 जनवरी 1950 को लागू हुआ था, जिसके उपलक्ष्य में गणतंत्र दिवस मनाया जाता है।", "chunk_id": "6470ef29a8e0", "strategy": "semantic_sentence", "language": "hin_Deva", "source_passage_index": 16, "query_type": "factual", "is_selected": true, "overlap_with_prev": false, "char_count": 91, "token_estimate": 30, "vector_id": 16}, {"text": "Goa is India's smallest state by area, famous for its coastline, heritage churches, and vibrant culture.", "chunk_id": "6b97fb5ee30e", "strategy": "semantic_sentence", "language": "eng_Latn", "source_passage_index": 17, "query_type": "factual", "is_selected": true, "overlap_with_prev": false, "char_count": 104, "token_estimate": 34, "vector_id": 17}, {"text": "गोवा भारत का सबसे छोटा राज्य है जो अपने सुंदर समुद्र तटों, पुर्तगाली वास्तुकला और पर्यटन के लिए प्रसिद्ध है।", "chunk_id": "0b4d961b8d50", "strategy": "semantic_sentence", "language": "hin_Deva", "source_passage_index": 18, "query_type": "factual", "is_selected": true, "overlap_with_prev": false, "char_count": 108, "token_estimate": 36, "vector_id": 18}, {"text": "கோவா இந்தியாவின் மிகச்சிறிய மாநிலமாகும். இது அழகான கடற்கரைகளுக்குப் பெயர் பெற்றது.", "chunk_id": "b1ee3ab40a9b", "strategy": "semantic_sentence", "language": "tam_Taml", "source_passage_index": 19, "query_type": "factual", "is_selected": true, "overlap_with_prev": false, "char_count": 82, "token_estimate": 27, "vector_id": 19}, {"text": "గోవా విస్తీర్ణంలో భారతదేశంలో అతి చిన్న రాష్ట్రం. ఇది అందమైన తీరప్రాంతాలకు ప్రసిద్ధి చెందింది.", "chunk_id": "82e7ddd546ad", "strategy": "semantic_sentence", "language": "tel_Telu", "source_passage_index": 20, "query_type": "factual", "is_selected": true, "overlap_with_prev": false, "char_count": 93, "token_estimate": 31, "vector_id": 20}, {"text": "গোয়া ভারতের ক্ষুদ্রতম রাজ্য, যা এর সমুদ্র সৈকত এবং পর্তুগিজ স্থাপত্যের জন্য বিখ্যাত।", "chunk_id": "76e1d598e529", "strategy": "semantic_sentence", "language": "ben_Beng", "source_passage_index": 21, "query_type": "factual", "is_selected": true, "overlap_with_prev": false, "char_count": 85, "token_estimate": 28, "vector_id": 21}, {"text": "Panaji is the capital city of Goa, located on the banks of the Mandovi River.", "chunk_id": "16ec50cdedc8", "strategy": "semantic_sentence", "language": "eng_Latn", "source_passage_index": 22, "query_type": "factual", "is_selected": true, "overlap_with_prev": false, "char_count": 77, "token_estimate": 25, "vector_id": 22}, {"text": "पणजी गोवा की राजधानी है जो मांडवी नदी के तट पर स्थित है।", "chunk_id": "469c7d922c94", "strategy": "semantic_sentence", "language": "hin_Deva", "source_passage_index": 23, "query_type": "factual", "is_selected": true, "overlap_with_prev": false, "char_count": 56, "token_estimate": 18, "vector_id": 23}, {"text": "Hacker House Goa is a 72-hour premier hackathon gathering top developers to build next-generation applications.", "chunk_id": "c810d1d45d02", "strategy": "semantic_sentence", "language": "eng_Latn", "source_passage_index": 24, "query_type": "factual", "is_selected": true, "overlap_with_prev": false, "char_count": 111, "token_estimate": 37, "vector_id": 24}, {"text": "हैकर हाउस गोवा एक 72 घंटे का प्रमुख हैकाथॉन है जहाँ शीर्ष डेवलपर्स अत्याधुनिक एआई एप्लीकेशन बनाते हैं।", "chunk_id": "cffa5e3eb703", "strategy": "semantic_sentence", "language": "hin_Deva", "source_passage_index": 25, "query_type": "factual", "is_selected": true, "overlap_with_prev": false, "char_count": 102, "token_estimate": 34, "vector_id": 25}, {"text": "ஹேக்கர் ஹவுஸ் கோவா என்பது சிறந்த மென்பொருள் உருவாக்குநர்கள் பங்கேற்கும் 72 மணிநேர ஹேகத்தான் ஆகும்.", "chunk_id": "7c5295f8f215", "strategy": "semantic_sentence", "language": "tam_Taml", "source_passage_index": 26, "query_type": "factual", "is_selected": true, "overlap_with_prev": false, "char_count": 98, "token_estimate": 32, "vector_id": 26}, {"text": "హ్యాకర్ హౌస్ గోవా అనేది అత్యుత్తమ డెవలపర్లు పాల్గొనే 72 గంటల హాకథాన్.", "chunk_id": "0ec99239214a", "strategy": "semantic_sentence", "language": "tel_Telu", "source_passage_index": 27, "query_type": "factual", "is_selected": true, "overlap_with_prev": false, "char_count": 69, "token_estimate": 23, "vector_id": 27}, {"text": "হ্যাকার হাউস গোয়া হলো একটি ৭২ ঘণ্টার প্রিমিয়ার হ্যাকাথন যেখানে সেরা ডেভেলপাররা উদ্ভাবনী অ্যাপ তৈরি করে।", "chunk_id": "b209d837b946", "strategy": "semantic_sentence", "language": "ben_Beng", "source_passage_index": 28, "query_type": "factual", "is_selected": true, "overlap_with_prev": false, "char_count": 105, "token_estimate": 35, "vector_id": 28}, {"text": "Hacker House Goa 2026 takes place from October 28 to October 31 in Goa, India with 247 builders.", "chunk_id": "5c44b849e6ad", "strategy": "semantic_sentence", "language": "eng_Latn", "source_passage_index": 29, "query_type": "factual", "is_selected": true, "overlap_with_prev": false, "char_count": 96, "token_estimate": 32, "vector_id": 29}, {"text": "हैकर हाउस गोवा 2026 का आयोजन 28 से 31 अक्टूबर तक गोवा में किया जा रहा है।", "chunk_id": "2de5bf9cf238", "strategy": "semantic_sentence", "language": "hin_Deva", "source_passage_index": 30, "query_type": "factual", "is_selected": true, "overlap_with_prev": false, "char_count": 73, "token_estimate": 24, "vector_id": 30}, {"text": "Sarvam AI is a pioneering Indian artificial intelligence startup building LLMs and speech recognition models for Indic languages.", "chunk_id": "077efe8d6842", "strategy": "semantic_sentence", "language": "eng_Latn", "source_passage_index": 31, "query_type": "factual", "is_selected": true, "overlap_with_prev": false, "char_count": 129, "token_estimate": 43, "vector_id": 31}, {"text": "सर्वम एआई (Sarvam AI) एक भारतीय एआई स्टार्टअप है जो भारतीय भाषाओं के लिए एलएलएम और वाक्-पहचान (STT) मॉडल विकसित करता है।", "chunk_id": "4a788449aaf0", "strategy": "semantic_sentence", "language": "hin_Deva", "source_passage_index": 32, "query_type": "factual", "is_selected": true, "overlap_with_prev": false, "char_count": 120, "token_estimate": 40, "vector_id": 32}, {"text": "சர்வம் ஏஐ என்பது இந்திய மொழிகளுக்கான செயற்கை நுண்ணறிவு மாதிரிகளை உருவாக்கும் நிறுவனமாகும்.", "chunk_id": "f56040acb82f", "strategy": "semantic_sentence", "language": "tam_Taml", "source_passage_index": 33, "query_type": "factual", "is_selected": true, "overlap_with_prev": false, "char_count": 90, "token_estimate": 30, "vector_id": 33}, {"text": "సర్వం AI అనేది భారతీయ భాషల కోసం ఆర్టిఫిషియల్ ఇంటెలిజెన్స్ నమూనాలను అభివృద్ధి చేసే సంస్థ.", "chunk_id": "c975de2707b2", "strategy": "semantic_sentence", "language": "tel_Telu", "source_passage_index": 34, "query_type": "factual", "is_selected": true, "overlap_with_prev": false, "char_count": 88, "token_estimate": 29, "vector_id": 34}, {"text": "সর্বম এআই হল একটি ভারতীয় কৃত্রিম বুদ্ধিমত্তা সংস্থা যা ভারতীয় ভাষার জন্য স্পিচ-টু-টেক্সট তৈরি করে।", "chunk_id": "63db54897f35", "strategy": "semantic_sentence", "language": "ben_Beng", "source_passage_index": 35, "query_type": "factual", "is_selected": true, "overlap_with_prev": false, "char_count": 100, "token_estimate": 33, "vector_id": 35}, {"text": "The Sun is the closest star to Earth, located at an average distance of about 149.6 million kilometers.", "chunk_id": "4b2cf2279765", "strategy": "semantic_sentence", "language": "eng_Latn", "source_passage_index": 36, "query_type": "factual", "is_selected": true, "overlap_with_prev": false, "char_count": 103, "token_estimate": 34, "vector_id": 36}, {"text": "सूर्य धरती (पृथ्वी) के सबसे नज़दीक स्थित तारा है, जो पृथ्वी से लगभग 14.96 करोड़ किलोमीटर दूर है।", "chunk_id": "f2d0f5e62f8d", "strategy": "semantic_sentence", "language": "hin_Deva", "source_passage_index": 37, "query_type": "factual", "is_selected": true, "overlap_with_prev": false, "char_count": 96, "token_estimate": 32, "vector_id": 37}, {"text": "சூரியன் பூமிக்கு மிக அருகில் அமைந்துள்ள விண்மீன் (நட்சத்திரம்) ஆகும்.", "chunk_id": "a602ebb48922", "strategy": "semantic_sentence", "language": "tam_Taml", "source_passage_index": 38, "query_type": "factual", "is_selected": true, "overlap_with_prev": false, "char_count": 69, "token_estimate": 23, "vector_id": 38}, {"text": "సూర్యుడు భూమికి అత్యంత సమీపంలో ఉన్న నక్షత్రం.", "chunk_id": "3112c8a13f79", "strategy": "semantic_sentence", "language": "tel_Telu", "source_passage_index": 39, "query_type": "factual", "is_selected": true, "overlap_with_prev": false, "char_count": 45, "token_estimate": 15, "vector_id": 39}, {"text": "সূর্য পৃথিবীর সবচেয়ে নিকটতম নক্ষত্র, যা পৃথিবী থেকে প্রায় ১৪৯.৬ মিলিয়ন কিলোমিটার দূরে অবস্থিত।", "chunk_id": "b88fd5824d39", "strategy": "semantic_sentence", "language": "ben_Beng", "source_passage_index": 40, "query_type": "factual", "is_selected": true, "overlap_with_prev": false, "char_count": 97, "token_estimate": 32, "vector_id": 40}, {"text": "Proxima Centauri is the second closest star to Earth after the Sun, located 4.24 light-years away.", "chunk_id": "8f0d97ed7170", "strategy": "semantic_sentence", "language": "eng_Latn", "source_passage_index": 41, "query_type": "factual", "is_selected": true, "overlap_with_prev": false, "char_count": 98, "token_estimate": 32, "vector_id": 41}, {"text": "सूर्य के बाद प्रॉक्सिमा सेंटॉरी पृथ्वी के सबसे नज़दीक वाला तारा है जो 4.24 प्रकाश-वर्ष दूर है।", "chunk_id": "478b06ee8c91", "strategy": "semantic_sentence", "language": "hin_Deva", "source_passage_index": 42, "query_type": "factual", "is_selected": true, "overlap_with_prev": false, "char_count": 94, "token_estimate": 31, "vector_id": 42}, {"text": "Seoul is the capital and largest metropolis of South Korea, officially known as the Republic of Korea.", "chunk_id": "e884cdde19c7", "strategy": "semantic_sentence", "language": "eng_Latn", "source_passage_index": 43, "query_type": "factual", "is_selected": true, "overlap_with_prev": false, "char_count": 102, "token_estimate": 34, "vector_id": 43}, {"text": "सियोल (Seoul) दक्षिण कोरिया (South Korea) की राजधानी और सबसे बड़ा शहर है।", "chunk_id": "d181ab5b3019", "strategy": "semantic_sentence", "language": "hin_Deva", "source_passage_index": 44, "query_type": "factual", "is_selected": true, "overlap_with_prev": false, "char_count": 73, "token_estimate": 24, "vector_id": 44}, {"text": "தென் கொரியாவின் தலைநகரம் சியோல் (Seoul) ஆகும்.", "chunk_id": "1c6e394646b7", "strategy": "semantic_sentence", "language": "tam_Taml", "source_passage_index": 45, "query_type": "factual", "is_selected": true, "overlap_with_prev": false, "char_count": 46, "token_estimate": 15, "vector_id": 45}, {"text": "దక్షిణ కొరియా రాజధాని సియోల్ (Seoul).", "chunk_id": "a7b23b6a7441", "strategy": "semantic_sentence", "language": "tel_Telu", "source_passage_index": 46, "query_type": "factual", "is_selected": true, "overlap_with_prev": false, "char_count": 37, "token_estimate": 12, "vector_id": 46}, {"text": "দক্ষিণ কোরিয়ার রাজধানী সিউল (Seoul)।", "chunk_id": "f775cb811b76", "strategy": "semantic_sentence", "language": "ben_Beng", "source_passage_index": 47, "query_type": "factual", "is_selected": true, "overlap_with_prev": false, "char_count": 37, "token_estimate": 12, "vector_id": 47}, {"text": "Washington, D.C. is the capital city of the United States of America.", "chunk_id": "f253c7883278", "strategy": "semantic_sentence", "language": "eng_Latn", "source_passage_index": 48, "query_type": "factual", "is_selected": true, "overlap_with_prev": false, "char_count": 69, "token_estimate": 23, "vector_id": 48}, {"text": "वॉशिंगटन डी.सी. संयुक्त राज्य अमेरिका (USA) की राजधानी है।", "chunk_id": "8e131e89afe1", "strategy": "semantic_sentence", "language": "hin_Deva", "source_passage_index": 49, "query_type": "factual", "is_selected": true, "overlap_with_prev": false, "char_count": 58, "token_estimate": 19, "vector_id": 49}, {"text": "Tokyo is the capital and most populous metropolis of Japan.", "chunk_id": "7f4603f78da8", "strategy": "semantic_sentence", "language": "eng_Latn", "source_passage_index": 50, "query_type": "factual", "is_selected": true, "overlap_with_prev": false, "char_count": 59, "token_estimate": 19, "vector_id": 50}, {"text": "टोक्यो (Tokyo) जापान की राजधानी और सबसे बड़ा महानगर है।", "chunk_id": "1aa747fbcad6", "strategy": "semantic_sentence", "language": "hin_Deva", "source_passage_index": 51, "query_type": "factual", "is_selected": true, "overlap_with_prev": false, "char_count": 55, "token_estimate": 18, "vector_id": 51}, {"text": "Paris is the capital and most populous city of France.", "chunk_id": "19a542c5b4e3", "strategy": "semantic_sentence", "language": "eng_Latn", "source_passage_index": 52, "query_type": "factual", "is_selected": true, "overlap_with_prev": false, "char_count": 54, "token_estimate": 18, "vector_id": 52}, {"text": "पेरिस (Paris) फ्रांस की राजधानी और सांस्कृतिक केंद्र है।", "chunk_id": "0b528e5f055b", "strategy": "semantic_sentence", "language": "hin_Deva", "source_passage_index": 53, "query_type": "factual", "is_selected": true, "overlap_with_prev": false, "char_count": 56, "token_estimate": 18, "vector_id": 53}, {"text": "London is the capital and largest city of the United Kingdom and England.", "chunk_id": "18f5cd7aeb2b", "strategy": "semantic_sentence", "language": "eng_Latn", "source_passage_index": 54, "query_type": "factual", "is_selected": true, "overlap_with_prev": false, "char_count": 73, "token_estimate": 24, "vector_id": 54}, {"text": "लंदन (London) यूनाइटेड किंगडम (UK) और इंग्लैंड की राजधानी है।", "chunk_id": "ddb344c13403", "strategy": "semantic_sentence", "language": "hin_Deva", "source_passage_index": 55, "query_type": "factual", "is_selected": true, "overlap_with_prev": false, "char_count": 61, "token_estimate": 20, "vector_id": 55}, {"text": "The four pillars of a democratic republic government are the Legislature (law-making), the Executive (law-enforcing), the Judiciary (law-interpreting and justice), and the Free Press or Media (public watchdog and accountability).", "chunk_id": "3645c20d1f5a", "strategy": "semantic_sentence", "language": "eng_Latn", "source_passage_index": 56, "query_type": "factual", "is_selected": true, "overlap_with_prev": false, "char_count": 229, "token_estimate": 76, "vector_id": 56}, {"text": "एक लोकतांत्रिक गणराज्य के चार मुख्य स्तंभ हैं: विधायिका (कानून निर्माण), कार्यपालिका (कानून लागू करना), न्यायपालिका (संविधान और न्याय की रक्षा), और स्वतंत्र मीडिया या प्रेस (पारदर्शिता और जवाबदेही)।", "chunk_id": "bad99f09ec50", "strategy": "semantic_sentence", "language": "hin_Deva", "source_passage_index": 57, "query_type": "factual", "is_selected": true, "overlap_with_prev": false, "char_count": 198, "token_estimate": 66, "vector_id": 57}, {"text": "ஜனநாயகத்தின் நான்கு தூண்கள்: சட்டமன்றம், நிர்வாகத்துறை, நீதித்துறை மற்றும் சுதந்திரமான ஊடகம் (பத்திரிகை).", "chunk_id": "c515a09d708f", "strategy": "semantic_sentence", "language": "tam_Taml", "source_passage_index": 58, "query_type": "factual", "is_selected": true, "overlap_with_prev": false, "char_count": 105, "token_estimate": 35, "vector_id": 58}, {"text": "ప్రజాస్వామ్యానికి నాలుగు స్తంభాలు: శాసనసభ (చట్టాల తయారీ), కార్యనిర్వాహక వ్యవస్థ, న్యాయవ్యవస్థ మరియు స్వేచ్ఛా మీడియా.", "chunk_id": "35f07d6e6077", "strategy": "semantic_sentence", "language": "tel_Telu", "source_passage_index": 59, "query_type": "factual", "is_selected": true, "overlap_with_prev": false, "char_count": 116, "token_estimate": 38, "vector_id": 59}, {"text": "গণতন্ত্রের চারটি স্তম্ভ হলো: আইনসভা, বিচার বিভাগ, নির্বাহী বিভাগ এবং মুক্ত সংবাদমাধ্যম বা মিডিয়া।", "chunk_id": "bdb587adb2ac", "strategy": "semantic_sentence", "language": "ben_Beng", "source_passage_index": 60, "query_type": "factual", "is_selected": true, "overlap_with_prev": false, "char_count": 98, "token_estimate": 32, "vector_id": 60}, {"text": "Gemini 2.0 Flash is a high-speed, cost-efficient multimodal model built by Google for low-latency AI generation.", "chunk_id": "481cb5dbdc92", "strategy": "semantic_sentence", "language": "eng_Latn", "source_passage_index": 61, "query_type": "factual", "is_selected": true, "overlap_with_prev": false, "char_count": 112, "token_estimate": 37, "vector_id": 61}, {"text": "जेमिनी 2.0 फ्लैश गूगल द्वारा निर्मित एक अत्यधिक तेज़ और कुशल एआई मॉडल है जो बहुत कम देरी (latency) में उत्तर प्रदान करता है।", "chunk_id": "39b6eef9d7f9", "strategy": "semantic_sentence", "language": "hin_Deva", "source_passage_index": 62, "query_type": "factual", "is_selected": true, "overlap_with_prev": false, "char_count": 124, "token_estimate": 41, "vector_id": 62}, {"text": "ஜெமினி 2.0 ஃப்ளாஷ் என்பது கூகிள் உருவாக்கிய அதிவேக செயற்கை நுண்ணறிவு மாதிரியாகும்.", "chunk_id": "36cb81e79c1b", "strategy": "semantic_sentence", "language": "tam_Taml", "source_passage_index": 63, "query_type": "factual", "is_selected": true, "overlap_with_prev": false, "char_count": 82, "token_estimate": 27, "vector_id": 63}, {"text": "జెమిని 2.0 ఫ్లాష్ అనేది గూగుల్ తయారుచేసిన వేగవంతమైన ఆర్టిఫిషియల్ ఇంటెలిజెన్స్ నమూనా.", "chunk_id": "ddbcc814bd42", "strategy": "semantic_sentence", "language": "tel_Telu", "source_passage_index": 64, "query_type": "factual", "is_selected": true, "overlap_with_prev": false, "char_count": 84, "token_estimate": 28, "vector_id": 64}, {"text": "FAISS (Facebook AI Similarity Search) is an open-source library for efficient vector similarity search and clustering.", "chunk_id": "b0a22def780c", "strategy": "semantic_sentence", "language": "eng_Latn", "source_passage_index": 65, "query_type": "factual", "is_selected": true, "overlap_with_prev": false, "char_count": 118, "token_estimate": 39, "vector_id": 65}, {"text": "फेसबुक एआई सिमिलरिटी सर्च (FAISS) वैक्टर की तीव्र खोज और रिट्रीवल के लिए एक शक्तिशाली ओपन-सोर्स लाइब्रेरी है।", "chunk_id": "d59c9b832844", "strategy": "semantic_sentence", "language": "hin_Deva", "source_passage_index": 66, "query_type": "factual", "is_selected": true, "overlap_with_prev": false, "char_count": 109, "token_estimate": 36, "vector_id": 66}, {"text": "Retrieval-Augmented Generation (RAG) enhances LLMs by retrieving factual passages from an indexed vector database before generating answers.", "chunk_id": "c5ed3ef50c83", "strategy": "semantic_sentence", "language": "eng_Latn", "source_passage_index": 67, "query_type": "factual", "is_selected": true, "overlap_with_prev": false, "char_count": 140, "token_estimate": 46, "vector_id": 67}, {"text": "रिट्रीवल-ऑगमेंटेड जनरेशन (RAG) बाहरी ज्ञान आधार से प्रासंगिक तथ्य खोजकर एआई उत्तरों को अधिक सटीक और तथ्य-आधारित बनाता है।", "chunk_id": "9607bae5086e", "strategy": "semantic_sentence", "language": "hin_Deva", "source_passage_index": 68, "query_type": "factual", "is_selected": true, "overlap_with_prev": false, "char_count": 121, "token_estimate": 40, "vector_id": 68}, {"text": "Hindi is written in the Devanagari script and is one of the official languages of the Government of India.", "chunk_id": "8e8f485e8d6e", "strategy": "semantic_sentence", "language": "eng_Latn", "source_passage_index": 69, "query_type": "factual", "is_selected": true, "overlap_with_prev": false, "char_count": 106, "token_estimate": 35, "vector_id": 69}, {"text": "हिंदी देवनागरी लिपि में लिखी जाती है और भारत की राजभाषाओं में से एक है।", "chunk_id": "de7312c6dcb1", "strategy": "semantic_sentence", "language": "hin_Deva", "source_passage_index": 70, "query_type": "factual", "is_selected": true, "overlap_with_prev": false, "char_count": 71, "token_estimate": 23, "vector_id": 70}, {"text": "Tamil is one of the longest-surviving classical languages in the world, with a rich literary tradition.", "chunk_id": "3c1ded162c68", "strategy": "semantic_sentence", "language": "eng_Latn", "source_passage_index": 71, "query_type": "factual", "is_selected": true, "overlap_with_prev": false, "char_count": 103, "token_estimate": 34, "vector_id": 71}, {"text": "தமிழ் உலகின் மிகப் பழமையான செம்மொழிகளில் ஒன்றாகும்.", "chunk_id": "2d013e6b25ec", "strategy": "semantic_sentence", "language": "tam_Taml", "source_passage_index": 72, "query_type": "factual", "is_selected": true, "overlap_with_prev": false, "char_count": 51, "token_estimate": 17, "vector_id": 72}, {"text": "Telugu is a Dravidian language spoken mainly in Andhra Pradesh and Telangana, known for its vocalic ending words.", "chunk_id": "0ad4e43b230b", "strategy": "semantic_sentence", "language": "eng_Latn", "source_passage_index": 73, "query_type": "factual", "is_selected": true, "overlap_with_prev": false, "char_count": 113, "token_estimate": 37, "vector_id": 73}, {"text": "తెలుగు ప్రధానంగా ఆంధ్రప్రదేశ్ మరియు తెలంగాణ రాష్ట్రాల్లో మాట్లాడబడుతుంది.", "chunk_id": "fc0f55ee8c38", "strategy": "semantic_sentence", "language": "tel_Telu", "source_passage_index": 74, "query_type": "factual", "is_selected": true, "overlap_with_prev": false, "char_count": 73, "token_estimate": 24, "vector_id": 74}, {"text": "Bengali is the official language of West Bengal and Bangladesh, written in the Bengali script.", "chunk_id": "f85d1eb95d1e", "strategy": "semantic_sentence", "language": "eng_Latn", "source_passage_index": 75, "query_type": "factual", "is_selected": true, "overlap_with_prev": false, "char_count": 94, "token_estimate": 31, "vector_id": 75}, {"text": "বাংলা পশ্চিমবঙ্গ এবং বাংলাদেশের সরকারি ভাষা।", "chunk_id": "5b0a6a07656a", "strategy": "semantic_sentence", "language": "ben_Beng", "source_passage_index": 76, "query_type": "factual", "is_selected": true, "overlap_with_prev": false, "char_count": 44, "token_estimate": 14, "vector_id": 76}, {"text": "India's space agency is ISRO (Indian Space Research Organisation), famous for the Chandrayaan and Mangalyaan missions.", "chunk_id": "910283402c1c", "strategy": "semantic_sentence", "language": "eng_Latn", "source_passage_index": 77, "query_type": "factual", "is_selected": true, "overlap_with_prev": false, "char_count": 118, "token_estimate": 39, "vector_id": 77}, {"text": "भारतीय अंतरिक्ष अनुसंधान संगठन (ISRO) भारत की राष्ट्रीय अंतरिक्ष एजेंसी है।", "chunk_id": "bf9c0ea47866", "strategy": "semantic_sentence", "language": "hin_Deva", "source_passage_index": 78, "query_type": "factual", "is_selected": true, "overlap_with_prev": false, "char_count": 75, "token_estimate": 25, "vector_id": 78}, {"text": "இந்திய விண்வெளி ஆராய்ச்சி நிறுவனம் (இஸ்ரோ) இந்தியாவின் விண்வெளி அமைப்பாகும்.", "chunk_id": "1886c169ed6d", "strategy": "semantic_sentence", "language": "tam_Taml", "source_passage_index": 79, "query_type": "factual", "is_selected": true, "overlap_with_prev": false, "char_count": 76, "token_estimate": 25, "vector_id": 79}, {"text": "భారత అంతరిక్ష పరిశోధనా సంస్థ (ఇస్రో) భారతదేశపు ప్రసిద్ధ అంతరిక్ష సంస్థ.", "chunk_id": "4a5cfda942d4", "strategy": "semantic_sentence", "language": "tel_Telu", "source_passage_index": 80, "query_type": "factual", "is_selected": true, "overlap_with_prev": false, "char_count": 71, "token_estimate": 23, "vector_id": 80}, {"text": "ভারতের মহাকাশ গবেষণা সংস্থা হলো ইসরো (ISRO)।", "chunk_id": "4cc781fb2546", "strategy": "semantic_sentence", "language": "ben_Beng", "source_passage_index": 81, "query_type": "factual", "is_selected": true, "overlap_with_prev": false, "char_count": 44, "token_estimate": 14, "vector_id": 81}, {"text": "Yoga originated in ancient India and is celebrated globally on International Yoga Day on June 21.", "chunk_id": "7720ea0af3af", "strategy": "semantic_sentence", "language": "eng_Latn", "source_passage_index": 82, "query_type": "factual", "is_selected": true, "overlap_with_prev": false, "char_count": 97, "token_estimate": 32, "vector_id": 82}, {"text": "योग की उत्पत्ति प्राचीन भारत में हुई थी और प्रतिवर्ष 21 जून को अंतर्राष्ट्रीय योग दिवस मनाया जाता है।", "chunk_id": "cab6a291e8c2", "strategy": "semantic_sentence", "language": "hin_Deva", "source_passage_index": 83, "query_type": "factual", "is_selected": true, "overlap_with_prev": false, "char_count": 101, "token_estimate": 33, "vector_id": 83}, {"text": "The Reserve Bank of India (RBI) is India's central bank and regulatory body for the banking sector.", "chunk_id": "2e6a32f8ab07", "strategy": "semantic_sentence", "language": "eng_Latn", "source_passage_index": 84, "query_type": "factual", "is_selected": true, "overlap_with_prev": false, "char_count": 99, "token_estimate": 33, "vector_id": 84}, {"text": "भारतीय रिज़र्व बैंक (RBI) भारत का केंद्रीय बैंक है जो मौद्रिक नीति को नियंत्रित करता है।", "chunk_id": "0b9ae467de0e", "strategy": "semantic_sentence", "language": "hin_Deva", "source_passage_index": 85, "query_type": "factual", "is_selected": true, "overlap_with_prev": false, "char_count": 88, "token_estimate": 29, "vector_id": 85}, {"text": "Taj Mahal is a white marble mausoleum located in Agra, Uttar Pradesh, built by Mughal Emperor Shah Jahan.", "chunk_id": "086389d457f7", "strategy": "semantic_sentence", "language": "eng_Latn", "source_passage_index": 86, "query_type": "factual", "is_selected": true, "overlap_with_prev": false, "char_count": 105, "token_estimate": 35, "vector_id": 86}, {"text": "ताजमहल आगरा, उत्तर प्रदेश में स्थित एक विश्व प्रसिद्ध संगमरमर का स्मारक है जिसे शाहजहाँ ने बनवाया था।", "chunk_id": "103af6afe740", "strategy": "semantic_sentence", "language": "hin_Deva", "source_passage_index": 87, "query_type": "factual", "is_selected": true, "overlap_with_prev": false, "char_count": 101, "token_estimate": 33, "vector_id": 87}, {"text": "The Supreme Court of India is the highest judicial authority in India, located in New Delhi.", "chunk_id": "43a0457ad355", "strategy": "semantic_sentence", "language": "eng_Latn", "source_passage_index": 88, "query_type": "factual", "is_selected": true, "overlap_with_prev": false, "char_count": 92, "token_estimate": 30, "vector_id": 88}, {"text": "भारत का सर्वोच्च न्यायालय (Supreme Court) देश की सर्वोच्च न्यायिक संस्था है।", "chunk_id": "fced6f392965", "strategy": "semantic_sentence", "language": "hin_Deva", "source_passage_index": 89, "query_type": "factual", "is_selected": true, "overlap_with_prev": false, "char_count": 76, "token_estimate": 25, "vector_id": 89}, {"text": "Classical Indian music has two primary traditions: Hindustani in the North and Carnatic in the South.", "chunk_id": "e81f03530f22", "strategy": "semantic_sentence", "language": "eng_Latn", "source_passage_index": 90, "query_type": "factual", "is_selected": true, "overlap_with_prev": false, "char_count": 101, "token_estimate": 33, "vector_id": 90}, {"text": "भारतीय शास्त्रीय संगीत की दो प्रमुख शैलियाँ हैं: उत्तर भारत की हिंदुस्तानी और दक्षिण भारत की कर्नाटक शैली।", "chunk_id": "da98f1f34ab9", "strategy": "semantic_sentence", "language": "hin_Deva", "source_passage_index": 91, "query_type": "factual", "is_selected": true, "overlap_with_prev": false, "char_count": 106, "token_estimate": 35, "vector_id": 91}, {"text": "Unified Payments Interface (UPI) is an instant real-time payment system developed by NPCI in India.", "chunk_id": "15a98b2b3201", "strategy": "semantic_sentence", "language": "eng_Latn", "source_passage_index": 92, "query_type": "factual", "is_selected": true, "overlap_with_prev": false, "char_count": 99, "token_estimate": 33, "vector_id": 92}, {"text": "यूपीआई (UPI) एनपीसीआई द्वारा विकसित भारत की तत्काल डिजिटल भुगतान प्रणाली है।", "chunk_id": "9411fdaeba07", "strategy": "semantic_sentence", "language": "hin_Deva", "source_passage_index": 93, "query_type": "factual", "is_selected": true, "overlap_with_prev": false, "char_count": 76, "token_estimate": 25, "vector_id": 93}, {"text": "Digital India is a flagship campaign launched by the Government of India to ensure digital access for all citizens.", "chunk_id": "ffdbb474f5e1", "strategy": "semantic_sentence", "language": "eng_Latn", "source_passage_index": 94, "query_type": "factual", "is_selected": true, "overlap_with_prev": false, "char_count": 115, "token_estimate": 38, "vector_id": 94}, {"text": "डिजिटल इंडिया भारत सरकार का एक प्रमुख अभियान है जिसका उद्देश्य देश को डिजिटल रूप से सशक्त बनाना है।", "chunk_id": "3a06d4fbfa81", "strategy": "semantic_sentence", "language": "hin_Deva", "source_passage_index": 95, "query_type": "factual", "is_selected": true, "overlap_with_prev": false, "char_count": 99, "token_estimate": 33, "vector_id": 95}, {"text": "The Indian Rupee (INR) is the official currency of India, represented by the symbol ₹.", "chunk_id": "ff2cecbe9d1b", "strategy": "semantic_sentence", "language": "eng_Latn", "source_passage_index": 96, "query_type": "factual", "is_selected": true, "overlap_with_prev": false, "char_count": 86, "token_estimate": 28, "vector_id": 96}, {"text": "भारतीय रुपया (INR) भारत की आधिकारिक मुद्रा है जिसका प्रतीक ₹ है।", "chunk_id": "97548c5e9d3d", "strategy": "semantic_sentence", "language": "hin_Deva", "source_passage_index": 97, "query_type": "factual", "is_selected": true, "overlap_with_prev": false, "char_count": 64, "token_estimate": 21, "vector_id": 97}, {"text": "Silicon Valley of India is a nickname for Bengaluru, known as India's leading IT export hub.", "chunk_id": "d7fc57826c74", "strategy": "semantic_sentence", "language": "eng_Latn", "source_passage_index": 98, "query_type": "factual", "is_selected": true, "overlap_with_prev": false, "char_count": 92, "token_estimate": 30, "vector_id": 98}, {"text": "बेंगलुरु को भारत की सिलिकॉन वैली कहा जाता है क्योंकि यह भारत का मुख्य सूचना प्रौद्योगिकी केंद्र है।", "chunk_id": "54571c53d634", "strategy": "semantic_sentence", "language": "hin_Deva", "source_passage_index": 99, "query_type": "factual", "is_selected": true, "overlap_with_prev": false, "char_count": 99, "token_estimate": 33, "vector_id": 99}, {"text": "पणजी गोवा की राजधानी है जो मांडवी नदी के तट पर स्थित है। (Reference entry #101)", "chunk_id": "96f2789787fd", "strategy": "semantic_sentence", "language": "hin_Deva", "source_passage_index": 100, "query_type": "factual", "is_selected": false, "overlap_with_prev": false, "char_count": 79, "token_estimate": 26, "vector_id": 100}, {"text": "Hacker House Goa is a 72-hour premier hackathon gathering top developers to build next-generation applications. (Reference entry #102)", "chunk_id": "5ca2840c40dd", "strategy": "semantic_sentence", "language": "eng_Latn", "source_passage_index": 101, "query_type": "factual", "is_selected": false, "overlap_with_prev": false, "char_count": 134, "token_estimate": 44, "vector_id": 101}, {"text": "हैकर हाउस गोवा एक 72 घंटे का प्रमुख हैकाथॉन है जहाँ शीर्ष डेवलपर्स अत्याधुनिक एआई एप्लीकेशन बनाते हैं। (Reference entry #103)", "chunk_id": "1e1f75360910", "strategy": "semantic_sentence", "language": "hin_Deva", "source_passage_index": 102, "query_type": "factual", "is_selected": false, "overlap_with_prev": false, "char_count": 125, "token_estimate": 41, "vector_id": 102}, {"text": "ஹேக்கர் ஹவுஸ் கோவா என்பது சிறந்த மென்பொருள் உருவாக்குநர்கள் பங்கேற்கும் 72 மணிநேர ஹேகத்தான் ஆகும். (Reference entry #104)", "chunk_id": "e1f9430dd815", "strategy": "semantic_sentence", "language": "tam_Taml", "source_passage_index": 103, "query_type": "factual", "is_selected": false, "overlap_with_prev": false, "char_count": 121, "token_estimate": 40, "vector_id": 103}, {"text": "హ్యాకర్ హౌస్ గోవా అనేది అత్యుత్తమ డెవలపర్లు పాల్గొనే 72 గంటల హాకథాన్. (Reference entry #105)", "chunk_id": "65f6f4b52251", "strategy": "semantic_sentence", "language": "tel_Telu", "source_passage_index": 104, "query_type": "factual", "is_selected": false, "overlap_with_prev": false, "char_count": 92, "token_estimate": 30, "vector_id": 104}]